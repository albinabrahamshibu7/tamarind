---
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Floating from '../components/Floating.astro';
import Price from '../components/Price.astro';
import Tag from '../components/Tag.astro';
import Torn from '../components/Torn.astro';
import { fullMenu, fullMenuCount } from '../data/fullMenu';
import { business, telLink, isDated, itemId } from '../data/site';
import type { FullGroup } from '../data/fullMenu';

// Desktop shows four cards a row, and categories run on into each other so no row is left half empty.
// Each category opens with a title tile; where a section would end on a short row, some title tiles
// are widened to two columns (only where the row has room) until the last row closes at four.
const COLS = 4;
const layout = (groups: FullGroup[]) => {
  const spans = groups.map(() => 1);
  let extra = (COLS - (groups.reduce((n, g) => n + 1 + g.items.length, 0) % COLS)) % COLS;
  let col = 0;
  groups.forEach((g, gi) => {
    if (extra > 0 && COLS - col >= 2) {
      spans[gi] = 2;
      extra--;
    }
    col = (col + spans[gi] + g.items.length) % COLS;
  });
  return spans;
};
const sections = fullMenu.map((s) => ({ ...s, spans: layout(s.groups) }));
// short chip labels: "Smoked BBQ Chicken, half" -> "Smoked BBQ Chicken"
const chip = (g: FullGroup) => g.title.split(',')[0];
---

<Layout
  title="Menu | Cafe Tamarind, Pala"
  description={`All ${fullMenuCount} dishes at Cafe Tamarind with prices and when each one is available: weekend brisket, the smokehouse from 6 PM, and the kitchen from 12:30 PM.`}
>
  <div class="sec theme-pit grain" style="z-index:30">
    <Header />
  </div>
  <Torn from="pit" to="paper" />

  <main id="main" class="fm sec theme-paper">
    <div class="wrap fm__inner">
      <header class="fm__head">
        <h1 class="display h2">The full menu</h1>
        <p class="body-l fm__lead">
          Every dish, with when you can have it. Tap one to add it to an order request.
        </p>
        <ul class="fm__key" role="list">
          <li><Tag when="now" /> from 12:30 PM</li>
          <li><Tag when="evening" /> every day</li>
          <li><Tag when="weekend" /> until sold out</li>
        </ul>
        <p class="fm__note">
          Smokehouse prices are from the September 2026 menu. Prices marked <span class="price price--dated fm__star">₹</span> are from older sheets
          and may have changed; the date is shown beside each group. 5% GST extra. Half and full al-faham: ask at the counter.
        </p>
        <nav class="fm__jump label" aria-label="Menu sections">
          {fullMenu.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
        </nav>
      </header>

      <!-- phones: every category as a button, pinned while you scroll -->
      <nav class="fm__cats" aria-label="Menu categories" data-cats>
        <div class="fm__cats-track">
          {
            fullMenu.map((s) => (
              <>
                <span class="fm__cats-sec label" aria-hidden="true">{s.title}</span>
                {s.groups.map((g) => (
                  <a class="fm__chip label" href={`#cat-${g.id}`} data-chip={`cat-${g.id}`}>
                    {chip(g)}
                  </a>
                ))}
              </>
            ))
          }
        </div>
      </nav>

      {
        sections.map((section) => (
          <section class="fm__section" id={section.id} aria-labelledby={`${section.id}-h`}>
            <h2 class="display fm__section-h" id={`${section.id}-h`} data-reveal="wipe">
              {section.title}
            </h2>
            <div class="fm__grid" data-stagger>
              {section.groups.map((g, gi) => [
                <div
                  class:list={['fm__cat theme-pit', { 'fm__cat--wide': section.spans[gi] === 2 }]}
                  id={`cat-${g.id}`}
                  data-cat
                >
                  <h3 class="display fm__cat-h">{g.title}</h3>
                  <span class="fm__cat-meta">
                    <Tag when={g.when} />
                    {isDated(g) && <span class="label muted">{g.asOf} prices</span>}
                  </span>
                  {g.comesWith && <p class="fm__with">With {g.comesWith.charAt(0).toLowerCase() + g.comesWith.slice(1)}.</p>}
                  <span class="fm__count label">
                    {g.items.length} {g.items.length === 1 ? 'dish' : 'dishes'}
                  </span>
                </div>,
                ...g.items.map((it, i) => (
                      <div class="fm__item">
                        <button class="fm__card" type="button" data-add={itemId(g, i)}>
                          <span class="fm__photo">
                            {it.image ? (
                              <img src={it.image} alt="" width="800" height="600" loading="lazy" decoding="async" />
                            ) : (
                              <span class="fm__ph" aria-hidden="true">
                                <svg viewBox="0 0 48 48" width="40" height="40">
                                  <circle cx="24" cy="24" r="17" fill="none" stroke="currentColor" stroke-width="2" />
                                  <circle cx="24" cy="24" r="10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3" />
                                </svg>
                                <span class="label">Photo soon</span>
                              </span>
                            )}
                            {it.serves && <span class="fm__serves label">Serves {it.serves}</span>}
                          </span>
                          <span class="fm__body">
                            <span class="fm__name">{it.name}</span>
                            {(it.note || it.veg != null) && (
                              <span class="fm__desc">{[it.note, it.veg != null && `Veg ₹${it.veg}`].filter(Boolean).join('. ')}</span>
                            )}
                            <span class="fm__foot">
                              <Price value={it.price} dated={isDated(g)} />
                              <span class="fm__add" aria-hidden="true">+</span>
                            </span>
                          </span>
                        </button>
                      </div>
                )),
              ])}
            </div>
          </section>
        ))
      }

      <aside class="fm__call" aria-label="Reserve brisket">
        <p class="display fm__call-h">The brisket runs out. Call ahead.</p>
        <a class="btn btn--inverse" href={telLink}>Call {business.phoneDisplay}</a>
      </aside>
    </div>
  </main>
  <Torn from="paper" to="pit" flip />

  <Footer />
  <Floating />
</Layout>

<script>
  import '../scripts/main.ts';

  // phones: light up the chip for the category on screen and keep it in view in the bar
  const bar = document.querySelector<HTMLElement>('[data-cats]');
  if (bar) {
    const chips = new Map([...bar.querySelectorAll<HTMLElement>('[data-chip]')].map((c) => [c.dataset.chip!, c]));
    const cats = [...document.querySelectorAll<HTMLElement>('[data-cat]')];
    let current: HTMLElement | undefined;
    let queued = false;
    const update = () => {
      queued = false;
      if (bar.offsetParent === null) return; // bar hidden above phone width
      // current = the last category whose title tile has passed just under the bar
      const line = bar.getBoundingClientRect().bottom + 90;
      let active: HTMLElement | undefined;
      for (const el of cats) {
        if (el.getBoundingClientRect().top > line) break;
        active = el;
      }
      const c = active && chips.get(active.id);
      if (c === current) return;
      current?.removeAttribute('aria-current');
      current = c;
      if (!c) return;
      c.setAttribute('aria-current', 'true');
      // scroll the bar only, never the page
      bar.scrollTo({ left: c.offsetLeft - 16, behavior: 'smooth' });
    };
    addEventListener(
      'scroll',
      () => {
        if (!queued) (queued = true), requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }
</script>

<style>
  .fm {
    padding-block: clamp(48px, 7vw, 100px) clamp(80px, 9vw, 130px);
  }
  .fm__inner {
    max-width: calc(1180px + var(--gutter) * 2);
  }
  .fm__head {
    display: grid;
    gap: 18px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  .fm__head h1,
  .fm__head p {
    margin: 0;
  }
  .fm__lead {
    max-width: 52ch;
  }
  .fm__key {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .fm__key li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .fm__note {
    max-width: 78ch;
    font-size: 14px;
    line-height: 21px;
    color: var(--ink-muted);
  }
  .fm__star {
    font-size: 16px;
    line-height: 1;
  }
  .fm__jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }
  .fm__jump a {
    padding: 10px 14px;
    border: 1px solid var(--line-strong);
    font-size: 12px;
    transition:
      background-color 0.2s,
      color 0.2s,
      translate 0.35s var(--spring);
  }
  .fm__jump a:hover {
    translate: 0 -3px;
  }
  .fm__jump a:hover {
    background: var(--surface-inverse);
    color: var(--ink-inverse);
    border-color: var(--surface-inverse);
  }

  .fm__section {
    padding-top: var(--space-12);
    scroll-margin-top: 72px;
  }
  .fm__section-h {
    margin: 0 0 var(--space-8);
    padding-bottom: var(--space-4);
    font-size: clamp(2.6rem, 5vw, 4rem);
    color: var(--accent);
    border-bottom: 2px solid var(--ink);
  }
  /* four a row on desktop; categories flow on into each other (spans set at build time) */
  .fm__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 20px);
  }
  /* category title tile: a charcoal card that opens each run of dishes */
  .fm__cat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: clamp(16px, 1.8vw, 24px);
    background: var(--surface);
    color: var(--ink);
    scroll-margin-top: 130px;
  }
  .fm__cat--wide {
    grid-column: span 2;
  }
  .fm__cat-h {
    margin: 0;
    font-size: clamp(1.7rem, 2.4vw, 2.3rem);
    line-height: 0.95;
    color: var(--brand);
  }
  .fm__cat-meta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .fm__with {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }
  .fm__count {
    margin-top: auto;
    padding-top: 6px;
    font-size: 11px;
    color: var(--ink-muted);
  }

  /* category buttons: phones only */
  .fm__cats {
    display: none;
  }
  .fm__item {
    display: flex;
  }
  .fm__card {
    width: 100%;
    display: flex;
    flex-direction: column;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    text-align: left;
    cursor: pointer;
    transition:
      transform 0.3s var(--ease-out),
      border-color 0.25s,
      box-shadow 0.3s;
  }
  .fm__card:hover,
  .fm__card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow-lift);
  }
  .fm__photo {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-sunken);
  }
  .fm__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .fm__card:hover .fm__photo img {
    transform: scale(1.05);
  }
  /* empty frame until the dish is photographed */
  .fm__ph {
    position: absolute;
    inset: 10px;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    border: 1px dashed var(--line-strong);
    color: var(--line-strong);
  }
  .fm__ph .label {
    font-size: 11px;
  }
  .fm__serves {
    position: absolute;
    left: 10px;
    top: 10px;
    padding: 5px 8px;
    background: var(--surface-inverse);
    color: var(--ink-inverse);
    font-size: 11px;
  }
  .fm__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px 16px;
  }
  .fm__name {
    font: 600 17px/23px var(--font-sans);
  }
  .fm__desc {
    font: 400 14px/20px var(--font-sans);
    color: var(--ink-muted);
  }
  .fm__foot {
    margin-top: auto;
    padding-top: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .fm__add {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid var(--line-strong);
    color: var(--brand-text);
    font-weight: 600;
    line-height: 1;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s,
      transform 0.45s var(--spring);
  }
  .fm__card:hover .fm__add,
  .fm__card:focus-visible .fm__add {
    transform: rotate(90deg);
    background: var(--brand);
    border-color: var(--brand);
    color: var(--on-brand);
  }
  .fm__call {
    margin-top: var(--space-12);
    padding: clamp(24px, 4vw, 44px);
    background: var(--brand);
    color: var(--on-brand);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  .fm__call-h {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.25rem);
  }
  /* phones: two cards a row so the photos still read */
  /* tablets: two a row; the build-time spans only line up at four, so drop them */
  @media (max-width: 960px) {
    .fm__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .fm__cat--wide {
      grid-column: auto;
    }
  }
  /* phones: one card a row, category buttons pinned to the top */
  @media (max-width: 600px) {
    .fm__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
    .fm__cat {
      gap: 10px;
      margin-top: 18px;
    }
    .fm__cat:first-child {
      margin-top: 0;
    }
    .fm__count {
      display: none;
    }
    .fm__jump {
      display: none;
    }
    .fm__cats {
      display: block;
      position: sticky;
      top: 0;
      z-index: 6;
      margin-inline: calc(var(--gutter) * -1);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      background: color-mix(in srgb, var(--surface) 94%, transparent);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
      transition: top 0.3s var(--ease-out);
    }
    .fm__cats::-webkit-scrollbar {
      display: none;
    }
    /* the floating site nav drops in on scroll-up: sit below it while it shows */
    :global(body:has(.nav.is-float:not(.is-hidden))) .fm__cats {
      top: 68px;
    }
    .fm__cats-track {
      display: flex;
      align-items: center;
      gap: 8px;
      width: max-content;
      padding: 10px var(--gutter);
    }
    .fm__cats-sec {
      padding: 0 4px 0 10px;
      font-size: 10px;
      color: var(--ink-muted);
      white-space: nowrap;
    }
    .fm__cats-sec:first-child {
      padding-left: 0;
    }
    .fm__chip {
      padding: 10px 14px;
      border: 1px solid var(--line-strong);
      font-size: 12px;
      white-space: nowrap;
      transition:
        background-color 0.2s,
        color 0.2s,
        border-color 0.2s;
    }
    .fm__chip[aria-current] {
      background: var(--surface-inverse);
      border-color: var(--surface-inverse);
      color: var(--ink-inverse);
    }
    .fm__section {
      scroll-margin-top: 70px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fm__card,
    .fm__photo img {
      transition: none;
    }
    .fm__card:hover,
    .fm__card:focus-visible {
      transform: none;
    }
  }
</style>
