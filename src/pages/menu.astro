---
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Floating from '../components/Floating.astro';
import Price from '../components/Price.astro';
import Tag from '../components/Tag.astro';
import { fullMenu, fullMenuCount } from '../data/fullMenu';
import { business, telLink, isDated, itemId } from '../data/site';
---

<Layout
  title="Menu | Cafe Tamarind, Pala"
  description={`All ${fullMenuCount} dishes at Cafe Tamarind with prices and when each one is available: weekend brisket, the smokehouse from 6 PM, and the kitchen from 12:30 PM.`}
>
  <div class="sec theme-pit grain" style="z-index:30">
    <Header />
  </div>

  <main id="main" class="fm sec theme-paper">
    <div class="wrap fm__inner">
      <header class="fm__head">
        <h1 class="display h2">The full menu</h1>
        <p class="body-l fm__lead">
          Every dish, with when you can have it. Tap one to add it to an order request.
        </p>
        <ul class="fm__key" role="list">
          <li><Tag when="now" /> from 12:30 PM</li>
          <li><Tag when="evening" /> every day</li>
          <li><Tag when="weekend" /> until sold out</li>
        </ul>
        <p class="fm__note">
          Smokehouse prices are from the September 2026 menu. Prices marked <span class="price price--dated fm__star">₹</span> are from older sheets
          and may have changed; the date is shown beside each group. 5% GST extra. Half and full al-faham: ask at the counter.
        </p>
        <nav class="fm__jump label" aria-label="Menu sections">
          {fullMenu.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
        </nav>
      </header>

      {
        fullMenu.map((section) => (
          <section class="fm__section" id={section.id} aria-labelledby={`${section.id}-h`}>
            <h2 class="display fm__section-h" id={`${section.id}-h`}>
              {section.title}
            </h2>
            <div class="fm__groups">
              {section.groups.map((g) => (
                <div class="fm__group">
                  <div class="fm__group-head">
                    <h3 class="h3">{g.title}</h3>
                    <span class="fm__group-meta">
                      <Tag when={g.when} />
                      {isDated(g) && <span class="label muted">{g.asOf} prices</span>}
                    </span>
                  </div>
                  {g.comesWith && <p class="fm__with">With {g.comesWith.charAt(0).toLowerCase() + g.comesWith.slice(1)}.</p>}
                  <ul class="fm__list" role="list">
                    {g.items.map((it, i) => (
                      <li>
                        <button class="fm__row" type="button" data-add={itemId(g, i)}>
                          <span class="fm__names">
                            <span class="fm__name">{it.name}</span>
                            {(it.note || it.serves || it.veg != null) && (
                              <span class="fm__desc">
                                {[it.serves && `Serves ${it.serves}`, it.note, it.veg != null && `Veg ₹${it.veg}`].filter(Boolean).join('. ')}
                              </span>
                            )}
                          </span>
                          <Price value={it.price} dated={isDated(g)} />
                          <span class="fm__add" aria-hidden="true">+</span>
                        </button>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        ))
      }

      <aside class="fm__call" aria-label="Reserve brisket">
        <p class="display fm__call-h">The brisket runs out. Call ahead.</p>
        <a class="btn btn--inverse" href={telLink}>Call {business.phoneDisplay}</a>
      </aside>
    </div>
  </main>

  <Footer />
  <Floating />
</Layout>

<script>
  import '../scripts/main.ts';
</script>

<style>
  .fm {
    padding-block: clamp(48px, 7vw, 100px) clamp(80px, 9vw, 130px);
  }
  .fm__inner {
    max-width: calc(1180px + var(--gutter) * 2);
  }
  .fm__head {
    display: grid;
    gap: 18px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  .fm__head h1,
  .fm__head p {
    margin: 0;
  }
  .fm__lead {
    max-width: 52ch;
  }
  .fm__key {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .fm__key li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .fm__note {
    max-width: 78ch;
    font-size: 14px;
    line-height: 21px;
    color: var(--ink-muted);
  }
  .fm__star {
    font-size: 16px;
    line-height: 1;
  }
  .fm__jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }
  .fm__jump a {
    padding: 10px 14px;
    border: 1px solid var(--line-strong);
    font-size: 12px;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .fm__jump a:hover {
    background: var(--surface-inverse);
    color: var(--ink-inverse);
    border-color: var(--surface-inverse);
  }

  .fm__section {
    padding-top: var(--space-12);
    scroll-margin-top: 72px;
  }
  .fm__section-h {
    margin: 0 0 var(--space-8);
    padding-bottom: var(--space-4);
    font-size: clamp(2.6rem, 5vw, 4rem);
    color: var(--accent);
    border-bottom: 2px solid var(--ink);
  }
  .fm__groups {
    columns: 2;
    column-gap: clamp(28px, 4vw, 64px);
  }
  .fm__group {
    break-inside: avoid;
    margin-bottom: var(--space-12);
  }
  .fm__group-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-bottom: 6px;
  }
  .fm__group-head h3 {
    margin: 0;
  }
  .fm__group-meta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .fm__with {
    margin: 0 0 10px;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }
  .fm__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .fm__row {
    width: 100%;
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    cursor: pointer;
  }
  .fm__names {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s var(--ease-out);
  }
  .fm__name {
    font: 600 17px/24px var(--font-sans);
  }
  .fm__desc {
    font: 400 14px/20px var(--font-sans);
    color: var(--ink-muted);
  }
  .fm__add {
    align-self: center;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    background: var(--brand);
    color: var(--on-brand);
    font-weight: 600;
    line-height: 1;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 0.2s,
      scale 0.3s var(--spring);
  }
  .fm__row:hover .fm__names,
  .fm__row:focus-visible .fm__names {
    transform: translateX(6px);
  }
  .fm__row:hover .fm__add,
  .fm__row:focus-visible .fm__add {
    opacity: 1;
    scale: 1;
  }
  @media (hover: none) {
    .fm__add {
      opacity: 1;
      scale: 1;
    }
  }
  .fm__call {
    margin-top: var(--space-12);
    padding: clamp(24px, 4vw, 44px);
    background: var(--brand);
    color: var(--on-brand);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  .fm__call-h {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.25rem);
  }
  @media (max-width: 820px) {
    .fm__groups {
      columns: 1;
    }
  }
</style>
