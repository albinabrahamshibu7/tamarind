---
import Logo from './Logo.astro';
import { nav, topBar, business } from '../data/site';
---

<div class="topbar" role="note">
  <ul class="topbar__list label">
    {
      topBar.map((text, i) => (
        <li class:list={['topbar__item', { 'topbar__item--status': i === 1 }]}>
          {i === 1 && <span class="topbar__dot" aria-hidden="true" data-open-dot />}
          <span data-open-status={i === 1 ? '' : undefined}>{text}</span>
        </li>
      ))
    }
  </ul>
</div>

<div class="nav-shell">
  <header class="nav wrap" data-nav>
    <a href="/#top" class="nav__logo" aria-label={`${business.name}, home`}>
      <Logo variant="wordmark-simple" tone="cream" height={46} />
    </a>

    <nav class="nav__links" aria-label="Primary">
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a href="/#contact" class="btn btn--s nav__cta">Get directions</a>

    <button class="nav__burger" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span></span><span></span>
    </button>
  </header>
</div>

<div id="mobile-menu" class="mmenu" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
  <nav aria-label="Mobile">
    {
      [...nav, { label: 'Find us', href: '/#contact' }].map((l, i) => (
        <a href={l.href} class="display" style={`--i:${i}`}>
          {l.label}
        </a>
      ))
    }
  </nav>
  <p class="mmenu__meta">{business.addressShort}<br />{business.hoursLong}</p>
</div>

<style>
  .topbar {
    background: var(--char-800);
    color: var(--ink-muted);
  }
  .topbar__list {
    display: flex;
    justify-content: center;
    gap: 32px;
    padding: 9px var(--gutter);
    list-style: none;
    margin: 0;
    font-size: 12px;
  }
  .topbar__item {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    white-space: nowrap;
  }
  .topbar__item--status {
    color: var(--ink);
  }
  .topbar__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--status-evening);
  }
  .topbar__dot[data-state="open"] {
    background: var(--status-now);
  }
  .topbar__dot[data-state="closed"] {
    background: transparent;
    border: 1.5px solid var(--status-soldout);
  }
  @media (max-width: 900px) {
    .topbar__item:not(.topbar__item--status) {
      display: none;
    }
  }

  .nav-shell {
    position: relative;
    z-index: 20;
    height: 88px;
  }
  .nav {
    position: absolute;
    inset: 0 0 auto 0;
    margin-inline: auto;
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.4s,
      padding 0.4s;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-top: 20px;
    padding-bottom: 20px;
  }
  .nav.is-float {
    position: fixed;
    max-width: none;
    padding-top: 10px;
    padding-bottom: 10px;
    background: color-mix(in srgb, var(--char-950) 92%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .nav.is-float.is-hidden {
    transform: translateY(-110%);
  }
  .nav__logo {
    justify-self: start;
  }
  .nav__links {
    display: flex;
    gap: 2px;
    padding: 4px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--char-900) 70%, transparent);
    backdrop-filter: blur(8px);
  }
  .nav__links a {
    padding: 10px 16px;
    font: 600 13px/1 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  .nav__links a:hover {
    background: var(--surface-inverse);
    color: var(--ink-inverse);
  }
  .nav__cta {
    justify-self: end;
  }
  .nav__burger {
    display: none;
    justify-self: end;
    width: 48px;
    height: 48px;
    background: var(--brand);
    position: relative;
    cursor: pointer;
  }
  .nav__burger span {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 2.5px;
    background: var(--on-brand);
    transition: transform 0.3s var(--ease-out);
  }
  .nav__burger span:first-child {
    top: 19px;
  }
  .nav__burger span:last-child {
    top: 27px;
  }
  .nav__burger[aria-expanded="true"] span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .nav__burger[aria-expanded="true"] span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .nav {
      grid-template-columns: 1fr auto;
    }
    .nav__links,
    .nav__cta {
      display: none;
    }
    .nav__burger {
      display: block;
    }
  }

  .mmenu {
    position: fixed;
    inset: 0;
    z-index: 15;
    background: var(--char-950);
    padding: 130px var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: auto;
    overscroll-behavior: contain;
  }
  .mmenu nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .mmenu a {
    font-size: clamp(3.4rem, 16vw, 5rem);
    color: var(--brand);
    animation: mm-in 0.5s var(--ease-out) both;
    animation-delay: calc(var(--i) * 55ms);
  }
  .mmenu__meta {
    color: var(--ink-muted);
    font-size: 15px;
  }
  @keyframes mm-in {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }
</style>
