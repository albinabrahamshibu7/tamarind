---
import Price from './Price.astro';
import Tag from './Tag.astro';
import { specials } from '../data/site';
---

<section class="specials sec theme-paper" aria-labelledby="specials-h">
  <div class="wrap">
    <h2 id="specials-h" class="display h2 specials__h" data-reveal="up">Off the<br />smoker</h2>
    <ul class="specials__grid" role="list">
      {
        specials.map((s, i) => (
          <li data-reveal="pop" style={`--delay:${i * 0.12}s`}>
            <article class="specials__card dish-host">
              <div class:list={['dish', { 'dish--plate': s.plate }]} style="--d:clamp(200px,21vw,290px)">
                <span class="dish__tile" />
                <span class="dish__img">
                  <img src={s.image} alt={s.alt} width="560" height="560" loading="lazy" decoding="async" />
                </span>
              </div>
              <h3 class="h3">{s.name.split(' ').map((w, i) => [i > 0 && ' ', w.includes('-') ? <span class="nowrap">{w}</span> : w])}</h3>
              <p class="specials__meta">
                <Tag when={s.when} />
                {s.desc && <span class="label muted">{s.desc}</span>}
              </p>
              <button class="specials__add" type="button" data-add={s.id} aria-label={`Add ${s.name} to your order`}>
                <Price value={s.price} dated={s.dated} />
                <span class="plus" aria-hidden="true">+</span>
              </button>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .specials {
    padding-block: clamp(60px, 8vw, 110px) clamp(72px, 9vw, 130px);
  }
  .specials__h {
    text-align: center;
    margin: 0 0 clamp(50px, 6vw, 90px);
  }
  .specials__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px 24px;
  }
  .specials__card {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    cursor: pointer;
  }
  .specials__card h3 {
    margin: 28px 0 0;
    max-width: 16ch;
  }
  .specials__meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px 12px;
  }
  /* plate, name, tag and price share rows across the cards, so they line up however a name wraps */
  @supports (grid-template-rows: subgrid) {
    .specials__grid > li,
    .specials__card {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: span 4;
      row-gap: 12px;
    }
    .specials__card {
      justify-items: center;
    }
  }
  .specials__add::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .specials__add {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    margin-top: 2px;
  }
  .plus {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    background: var(--brand);
    color: var(--on-brand);
    font-weight: 600;
    font-size: 20px;
    line-height: 1;
    transition: transform 0.35s var(--spring);
  }
  .specials__card:hover .plus,
  .specials__add:focus-visible .plus {
    transform: rotate(90deg);
  }
  @media (max-width: 760px) {
    .specials__grid {
      grid-template-columns: 1fr;
    }
    .specials__card .dish {
      --d: min(64vw, 280px) !important;
    }
  }
</style>
