---
import { slabRow } from '../lib/slab';

interface Props {
  /** where the slab row sits inside its (paper) section */
  at: 'top' | 'bottom';
  seed: number;
  height?: number;
}
const { at, seed, height = 84 } = Astro.props;
const slabs = slabRow(seed, height);
---

<svg
  class:list={['slab-edge', `slab-edge--${at}`]}
  viewBox={`0 0 1440 ${height}`}
  preserveAspectRatio="none"
  aria-hidden="true"
  style={`--h:${height}px`}
>
  {
    slabs.map((s) => (
      <g>
        <rect x={s.x} y={at === 'top' ? 0 : height - s.h} width={s.w + 0.5} height={s.h} style={`fill:${s.fill}`} />
        {s.rules &&
          [0.34, 0.56, 0.78].map((t) => {
            const y = at === 'top' ? s.h * t : height - s.h * t;
            return <line x1={s.x} y1={y - 5} x2={s.x + s.w} y2={y + 5} stroke="var(--paper-100)" stroke-width="1.5" opacity="0.4" vector-effect="non-scaling-stroke" />;
          })}
      </g>
    ))
  }
</svg>

<style>
  .slab-edge {
    position: absolute;
    left: 0;
    width: 100%;
    height: clamp(36px, 6vw, var(--h));
    z-index: 2;
    pointer-events: none;
  }
  .slab-edge--top {
    top: -1px;
  }
  .slab-edge--bottom {
    bottom: -1px;
  }
</style>
