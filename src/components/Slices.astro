---
// Three hairline rules: slices of brisket. The brand's one literal motif.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<svg class:list={['slices', cls]} viewBox="0 0 56 28" aria-hidden="true">
  <line x1="0" y1="2" x2="56" y2="10" stroke="currentColor" stroke-width="2"></line>
  <line x1="0" y1="10" x2="56" y2="18" stroke="currentColor" stroke-width="2"></line>
  <line x1="0" y1="18" x2="56" y2="26" stroke="currentColor" stroke-width="2"></line>
</svg>
