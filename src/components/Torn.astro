---
// Torn-paper seam between a charcoal and a paper section.
// The upper colour is drawn as the ripped sheet; the lower colour sits behind it.
interface Props {
  from: 'pit' | 'paper';
  to: 'pit' | 'paper';
  /** mirror the tear so neighbouring seams don't repeat */
  flip?: boolean;
}
const { from, to, flip = false } = Astro.props;
const color = { pit: 'var(--char-950)', paper: 'var(--paper-50)' };
---

<div class:list={['torn', { 'torn--flip': flip }]} style={`--from:${color[from]};--to:${color[to]}`} aria-hidden="true">
  <svg viewBox="0 0 1440 48" preserveAspectRatio="none" focusable="false">
    <path
      d="M0 0H1440V39L1382 40 1370 38 1269 28 1255 34 1244 37 1205 44 1186 40 1174 32 1087 30 1073 34 1061 28 1039 27 917 30 894 23 875 19 864 24 779 21 766 28 656 38 627 44 611 37 601 42 476 30 461 29 437 23 416 21 389 14 370 15 340 24 323 17 306 16 299 10 282 6 219 15 121 31 98 37 0 36Z"
    ></path>
  </svg>
</div>

<style>
  .torn {
    position: relative;
    z-index: 4;
    height: clamp(18px, 3.4vw, 48px);
    margin-block: -1px;
    background: var(--to);
    pointer-events: none;
  }
  .torn svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--from);
    /* a faint lip along the rip, like the edge of torn card */
    filter: drop-shadow(0 2px 0 rgba(0, 0, 0, 0.18));
  }
  .torn--flip svg {
    transform: scaleX(-1);
  }
</style>
