---
import Tag from './Tag.astro';
import { heroSlides, heroSub, business, telLink } from '../data/site';

// The line splits around the plate: left words, the plate, right words.
const lines: [string, string][] = [
  ['SIXTEEN', 'HOURS.'],
  ['SLICED', 'TO ORDER.'],
];
let n = 0;
// each letter gets its place in the drop-in sequence; spaces keep their width
const split = (word: string) => [...word].map((ch) => ({ ch, i: ch === ' ' ? -1 : n++ }));
const rows = lines.map(([l, r]) => ({ l: split(l), r: split(r) }));
---

<section id="top" class="hero sec theme-pit grain" aria-roledescription="carousel" aria-label="From the smoker and the kitchen">
  <div class="hero__stage" data-hero style="--dir:1">
    <h1 class="hero__title display" aria-label={business.tagline}>
      {
        rows.map((row) => (
          <span class="hero__line" aria-hidden="true">
            <span class="hero__half hero__half--l">
              {row.l.map((c) => (c.i < 0 ? <span class="char">&nbsp;</span> : <span class="char hero__char" style={`--i:${c.i}`}>{c.ch}</span>))}
            </span>
            <span class="hero__gap" />
            <span class="hero__half hero__half--r">
              {row.r.map((c) => (c.i < 0 ? <span class="char">&nbsp;</span> : <span class="char hero__char" style={`--i:${c.i}`}>{c.ch}</span>))}
            </span>
          </span>
        ))
      }
    </h1>

    <div class="hero__food" data-hero-food>
      {
        heroSlides.map((s, i) => (
          <figure
            class:list={['hero__slide', { 'is-active': i === 0 }]}
            data-slide={i}
            data-accent={s.accent}
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${heroSlides.length}`}
            aria-hidden={i === 0 ? 'false' : 'true'}
          >
            <div class="hero__plate">
              <img
                src={s.image}
                srcset={`${s.imageSm} 560w, ${s.image} 1000w`}
                sizes="(max-width: 700px) 66vw, 30vw"
                alt={s.alt}
                width="1000"
                height="1000"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                decoding="async"
              />
            </div>
            <span class="hero__when" style="--k:0"><Tag when={s.when} /></span>
            <span class="hero__chip hero__chip--a label" style="--k:1" aria-hidden="true">{s.chips[0]}</span>
            <span class="hero__chip hero__chip--b label" style="--k:2" aria-hidden="true">{s.chips[1]}</span>
            <figcaption class="hero__name" style="--k:3">{s.name}</figcaption>
          </figure>
        ))
      }
    </div>

    <button class="hero__arrow hero__arrow--prev" type="button" data-hero-prev aria-label="Previous dish">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"></path></svg>
    </button>
    <button class="hero__arrow hero__arrow--next" type="button" data-hero-next aria-label="Next dish">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"></path></svg>
    </button>
  </div>

  <div class="hero__foot wrap">
    <p class="lead hero__sub">{heroSub}</p>
    <div class="hero__ctas">
      <a href={telLink} class="btn btn--primary">Call to reserve brisket</a>
      <a href="#menu" class="btn">See the menu</a>
    </div>
    <p class="sr-only" aria-live="polite" data-hero-live></p>
  </div>
</section>

<style>
  .hero {
    --plate: clamp(220px, 29vw, 440px);
    padding-bottom: clamp(80px, 9vw, 130px);
    overflow: hidden;
  }
  .hero__stage {
    position: relative;
    width: 100%;
    max-width: 1440px;
    margin: clamp(28px, 5vw, 76px) auto 0;
    padding-block: clamp(48px, 7.5vw, 112px);
    /* keep horizontal swipes for the carousel; vertical still scrolls */
    touch-action: pan-y;
  }
  .hero__title {
    color: var(--hero-accent);
    margin: 0;
    font-size: clamp(2.6rem, 8.1vw, 7.7rem);
    display: grid;
    gap: 0.06em;
    position: relative;
    z-index: 1;
  }
  .hero__line {
    display: grid;
    grid-template-columns: 1fr calc(var(--plate) * 0.9) 1fr;
    align-items: center;
    white-space: nowrap;
  }
  .hero__half--l {
    text-align: right;
    padding-right: 0.16em;
  }
  .hero__half--r {
    text-align: left;
    padding-left: 0.16em;
  }
  .hero__char {
    animation: char-drop 0.8s var(--ease-out) both;
    animation-delay: calc(0.15s + var(--i) * 0.04s);
  }
  @keyframes char-drop {
    from {
      opacity: 0;
      transform: translateY(-0.4em);
    }
  }

  .hero__food {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--plate);
    aspect-ratio: 1;
    translate: -50% -50%;
    z-index: 2;
    animation: food-in 1.1s var(--spring) 0.7s both;
  }
  @keyframes food-in {
    from {
      opacity: 0;
      transform: scale(0.3) rotate(-120deg);
    }
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    transform: translateX(calc(var(--dir) * 70vw)) rotate(calc(var(--dir) * 90deg)) scale(0.8);
    transition:
      transform 1.05s var(--ease-out),
      opacity 0.6s var(--ease-out);
  }
  .hero__slide.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .hero__slide.is-leaving {
    opacity: 0;
    transform: translateX(calc(var(--dir) * -70vw)) rotate(calc(var(--dir) * -90deg)) scale(0.8);
  }
  /* transparent top-down plate cutout. The plate is round, so a static circular shadow
     stands in for drop-shadow: a filter over the spinning image would repaint every frame. */
  .hero__plate {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .hero__plate::before {
    content: "";
    position: absolute;
    inset: 3%;
    border-radius: 50%;
    box-shadow:
      0 34px 48px rgba(0, 0, 0, 0.55),
      0 8px 12px rgba(0, 0, 0, 0.35);
  }
  .hero__plate img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    animation: spin 90s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hero__when,
  .hero__chip,
  .hero__name {
    position: absolute;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 0.35s,
      scale 0.55s var(--spring);
  }
  .hero__when {
    left: -6%;
    top: 2%;
    padding: 6px 8px;
    background: var(--char-950);
    rotate: -8deg;
  }
  .hero__chip {
    padding: 7px 10px;
    background: var(--char-950);
    border: 1px solid var(--hero-accent);
    color: var(--ink);
    white-space: nowrap;
  }
  .hero__chip--a {
    right: -10%;
    top: 14%;
    rotate: 6deg;
  }
  .hero__chip--b {
    left: -12%;
    /* below the second headline line, so it never sits on a letter */
    bottom: 8%;
    rotate: -4deg;
  }
  .hero__name {
    left: 50%;
    bottom: -4%;
    translate: -50% 0;
    padding: 7px 14px 6px;
    background: var(--surface-inverse);
    color: var(--ink-inverse);
    font: 700 clamp(15px, 1.5vw, 21px) / 1.1 var(--font-display);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hero__slide.is-active .hero__when,
  .hero__slide.is-active .hero__chip,
  .hero__slide.is-active .hero__name {
    opacity: 1;
    scale: 1;
    transition-delay: calc(0.55s + var(--k) * 0.09s);
  }
  /* first paint: labels wait for the intro */
  :global(html:not(.hero-ready)) .hero__slide.is-active .hero__when,
  :global(html:not(.hero-ready)) .hero__slide.is-active .hero__chip,
  :global(html:not(.hero-ready)) .hero__slide.is-active .hero__name {
    transition-delay: calc(1.5s + var(--k) * 0.1s);
  }

  .hero__arrow {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    z-index: 3;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    background: transparent;
    border: 2px solid var(--line-strong);
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  .hero__arrow:hover {
    background: var(--surface-inverse);
    border-color: var(--surface-inverse);
    color: var(--ink-inverse);
  }
  .hero__arrow:active {
    scale: 0.94;
  }
  .hero__arrow--prev {
    left: var(--gutter);
  }
  .hero__arrow--next {
    right: var(--gutter);
  }
  /* the arrows sit under the outer words on mid screens */
  @media (max-width: 1100px) {
    .hero__arrow {
      top: auto;
      bottom: -36px;
      translate: none;
    }
    .hero__foot {
      margin-top: 64px;
    }
  }

  .hero__foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 26px;
    margin-top: clamp(20px, 2.6vw, 36px);
    animation: foot-in 0.9s var(--ease-out) 1.1s both;
  }
  @keyframes foot-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  .hero__sub {
    max-width: 620px;
    margin: 0;
    color: var(--ink-muted);
    text-wrap: balance;
  }
  .hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* phones: the sentence closes up into two lines and the plate sits under it */
  @media (max-width: 700px) {
    .hero {
      --plate: 62vw;
    }
    .hero__stage {
      margin-top: 10px;
      padding-block: 4vw 0;
    }
    .hero__title {
      font-size: 12.4vw;
      text-align: center;
    }
    .hero__line {
      display: block;
    }
    .hero__half--l,
    .hero__half--r {
      padding: 0;
    }
    .hero__gap {
      display: inline-block;
      width: 0.22em;
    }
    .hero__food {
      position: relative;
      left: auto;
      top: auto;
      translate: none;
      margin: 6vw auto 0;
    }
    .hero__when {
      left: -12%;
    }
    .hero__chip--a {
      right: -14%;
    }
    .hero__chip--b {
      left: -14%;
      /* no headline beside the plate here; sit clear of the dish name instead */
      bottom: 22%;
    }
    /* arrows flank the dish name, so the buttons below stay in the first screen */
    .hero__arrow {
      bottom: -36px;
      width: 44px;
      height: 44px;
    }
    .hero__arrow--prev {
      left: var(--gutter);
    }
    .hero__arrow--next {
      right: var(--gutter);
    }
    .hero__foot {
      margin-top: 62px;
      gap: 20px;
    }
  }
</style>
