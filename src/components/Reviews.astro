---
import { reviews, igCaption, stories, business } from '../data/site';

const cards = [
  { ...reviews[0], kind: 'google' },
  { ...reviews[1], kind: 'google' },
  { quote: igCaption.quote, about: '', source: igCaption.source, stars: 0, kind: 'ig' },
  { ...reviews[2], kind: 'google' },
];
const cols = [cards.filter((_, i) => i % 2 === 0), cards.filter((_, i) => i % 2 === 1)];
---

<section id="reviews" class="rev sec theme-paper" aria-labelledby="rev-h">
  <div class="wrap">
    <header class="rev__head">
      <h2 id="rev-h" class="display h2" data-reveal="up">What Pala<br />says</h2>
      <a class="rev__score" href={business.placeUrl} target="_blank" rel="noopener noreferrer" data-reveal="up" style="--delay:.1s">
        <span class="rev__score-fig">{business.rating}</span>
        <span>out of 5 on Google<br />{business.reviewCount} reviews</span>
      </a>
    </header>

    <div class="rev__grid">
      <div class="story" data-story data-reveal="left" role="region" aria-roledescription="carousel" aria-label={`Photos from ${business.name}`}>
        <div class="story__bars" aria-hidden="true">
          {stories.map(() => <span class="story__bar"><i /></span>)}
        </div>
        <div class="story__who">
          <span class="story__avatar" aria-hidden="true"><img src="/logo/tamarind-icon-ember-lit.svg" alt="" width="20" height="24" /></span>
          <strong>{business.instagramHandle}</strong>
        </div>
        {
          stories.map((s, i) => (
            <figure class:list={['story__frame', { 'is-on': i === 0 }]} data-frame aria-hidden={i === 0 ? 'false' : 'true'}>
              <img class="story__blur" src={s.src} alt="" aria-hidden="true" width="700" height="840" loading="lazy" decoding="async" />
              <img class="story__img" src={s.src} alt={s.caption} width="700" height="840" loading="lazy" />
              <figcaption class="story__cap">{s.caption}</figcaption>
            </figure>
          ))
        }
        <button class="story__tap story__tap--prev" type="button" data-story-prev aria-label="Previous photo"></button>
        <button class="story__tap story__tap--next" type="button" data-story-next aria-label="Next photo"></button>
        <a class="story__follow label" href={business.instagramUrl} target="_blank" rel="noopener noreferrer">Follow on Instagram</a>
      </div>

      {
        cols.map((col, c) => (
          <div class="rev__col">
            {col.map((card, i) => (
              <figure class="rev__card" data-reveal="up" style={`--delay:${(c + i * 2) * 0.1}s`}>
                <figcaption class="rev__who label">{card.source}{card.about && `, ${card.about}`}</figcaption>
                <blockquote>“{card.quote}”</blockquote>
                {card.stars > 0 && <p class="rev__stars label">{card.stars} out of 5</p>}
              </figure>
            ))}
          </div>
        ))
      }
    </div>
    <p class="rev__fine">Short excerpts from public Google reviews and the Cafe Tamarind Instagram. Reviewer names withheld.</p>
  </div>
</section>

<style>
  .rev {
    padding-block: clamp(60px, 8vw, 120px) clamp(80px, 10vw, 140px);
  }
  .rev__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .rev__head h2 {
    margin: 0;
  }
  .rev__score {
    display: inline-flex;
    gap: 14px;
    align-items: center;
    font-size: 15px;
    line-height: 20px;
    color: var(--ink-muted);
  }
  .rev__score-fig {
    font: 800 clamp(3rem, 5vw, 4.5rem) / 0.9 var(--font-display);
    color: var(--brand-text);
  }
  .rev__score:hover {
    color: var(--ink);
  }
  .rev__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24px;
  }
  .rev__col {
    display: grid;
    grid-auto-rows: 1fr;
    gap: 24px;
  }
  .rev__card {
    margin: 0;
    padding: 32px;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 20px;
    min-height: 240px;
    transition: transform 0.4s var(--spring);
  }
  .rev__card:hover {
    transform: rotate(-1deg) scale(1.01);
  }
  .rev__who {
    color: var(--accent);
  }
  .rev__card blockquote {
    margin: 0;
    align-self: end;
    font: 700 clamp(1.6rem, 2.3vw, 2rem) / 1.08 var(--font-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .rev__stars {
    margin: 0;
    color: var(--ink-muted);
  }
  .rev__fine {
    margin: 24px 0 0;
    font-size: 13px;
    color: var(--ink-muted);
  }

  /* story player */
  .story {
    position: relative;
    aspect-ratio: 9 / 15;
    overflow: hidden;
    border: 4px solid var(--char-950);
    background: var(--char-950);
    color: #fff;
    isolation: isolate;
  }
  .story__bars {
    position: absolute;
    z-index: 3;
    top: 14px;
    left: 14px;
    right: 14px;
    display: flex;
    gap: 5px;
  }
  .story__bar {
    flex: 1;
    height: 3px;
    background: rgba(255, 255, 255, 0.35);
    overflow: hidden;
  }
  .story__bar i {
    display: block;
    height: 100%;
    width: 100%;
    background: #fff;
    transform-origin: 0 50%;
    transform: scaleX(var(--f, 0));
  }
  .story__who {
    position: absolute;
    z-index: 3;
    top: 28px;
    left: 14px;
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 15px;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
  }
  .story__avatar {
    width: 32px;
    height: 32px;
    background: var(--char-950);
    display: grid;
    place-items: center;
  }
  .story__avatar img {
    width: 18px;
    height: auto;
  }
  .story__frame {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 0.5s;
    display: grid;
    place-items: center;
  }
  .story__frame.is-on {
    opacity: 1;
  }
  .story__blur {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    object-fit: cover;
    filter: blur(28px) saturate(1.2) brightness(0.55);
  }
  .story__img {
    position: relative;
    width: 82%;
    max-height: 72%;
    object-fit: cover;
    outline: 6px solid #fffdf8;
  }
  .story__frame.is-on .story__img {
    animation: kb 6s ease-out both;
  }
  @keyframes kb {
    from {
      transform: scale(0.95) rotate(-1.2deg);
    }
    to {
      transform: scale(1) rotate(0.4deg);
    }
  }
  .story__cap {
    position: absolute;
    left: 50%;
    bottom: 15%;
    translate: -50% 0;
    padding: 7px 14px 6px;
    background: var(--ember-500);
    color: var(--char-950);
    font: 700 20px/1.1 var(--font-display);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    rotate: -2deg;
  }
  .story__tap {
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    width: 40%;
    cursor: pointer;
  }
  .story__tap--prev {
    left: 0;
  }
  .story__tap--next {
    right: 0;
  }
  .story__follow {
    position: absolute;
    z-index: 3;
    right: 16px;
    bottom: 18px;
    padding: 9px 12px;
    background: rgba(20, 17, 15, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 1000px) {
    .rev__grid {
      grid-template-columns: 1fr 1fr;
    }
    .story {
      grid-row: span 2;
    }
  }
  @media (max-width: 680px) {
    .rev__grid {
      grid-template-columns: 1fr;
    }
    .rev__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .story {
      max-width: 380px;
      width: 100%;
      margin-inline: auto;
    }
  }
</style>
